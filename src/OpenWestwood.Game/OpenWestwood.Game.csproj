<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenWestwood.Client\OpenWestwood.Client.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The executable is called OpenWESTWOOD.exe (OpenWESTWOOD on macOS/Linux). -->
    <AssemblyName>OpenWESTWOOD</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Culture-free text handling: the same on every computer and language, and no ICU library needed on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- "dotnet publish -r win-x64" (or osx-arm64, linux-x64) makes one self-contained file. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
